# Perfume Aura marketing public_html — fail-closed public surface (SEC-7)
# SOURCE OF TRUTH: apps/marketing/.htaccess
# Publish to repo root via: pnpm marketing:sync
#
# Classic Git deploys the whole monorepo into public_html.
# Only the marketing static surface is intentionally public:
#   /  /index.html  /styles.css  /assets/*
# Everything else is denied.

Options -Indexes

# --- Authz belt (basename matches; works without rewrite) ---
<IfModule mod_authz_core.c>
  Require all granted

  <FilesMatch "^\.env">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.envrc$">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(pem|key)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(id_rsa|id_ed25519)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(\.gitignore|\.gitattributes|\.gitmodules|\.npmrc|\.nvmrc|\.node-version|\.graphifyignore)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(package\.json|package-lock\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|skills-lock\.json)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(md|MD)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "^\.env">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "\.(pem|key|md)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^(package\.json|package-lock\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|skills-lock\.json|\.graphifyignore)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# --- Fail-closed rewrite allowlist ---
# mod_rewrite is required. Do not wrap this allowlist in <IfModule>: if rewrite is
# unavailable the configuration must fail instead of exposing monorepo paths.
RewriteEngine On

# Explicitly allow the marketing publish surface only.
RewriteRule ^$ - [L]
RewriteRule ^index\.html$ - [L]
RewriteRule ^styles\.css$ - [L]
RewriteRule ^assets/ - [L]

# Everything else (apps, packages, docs, data, graphify-out, scripts, secrets, etc.) is forbidden.
RewriteRule ^ - [F,L]
