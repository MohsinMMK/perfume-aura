[global]
# An off-host S3-compatible repository is mandatory. Do not use a local VPS
# path as repo1: a VPS loss must not destroy the only backup copy.
repo1-type=s3
repo1-path=/perfume-aura-postgres
repo1-s3-bucket=REPLACE_WITH_PRIVATE_BUCKET
repo1-s3-endpoint=REPLACE_WITH_S3_ENDPOINT
repo1-s3-region=REPLACE_WITH_REGION
repo1-s3-uri-style=path
repo1-s3-key=REPLACE_WITH_ACCESS_KEY
repo1-s3-key-secret=REPLACE_WITH_SECRET_KEY
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_LONG_RANDOM_BACKUP_CIPHER_PASSPHRASE
repo1-retention-full=2
repo1-retention-diff=7
repo1-bundle=y
repo1-block=y

archive-async=y
spool-path=/var/lib/pgbackrest/spool
log-level-console=info
log-level-file=info
log-path=/var/lib/pgbackrest/log
process-max=2
start-fast=y

[perfume_aura]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
