[global]
# repo1 is an encrypted repository on its own VPS Docker volume. It provides
# point-in-time recovery, not protection from losing the VPS itself; keep a
# second copy elsewhere (see ../RUNBOOK.md).
repo1-type=posix
repo1-path=/var/lib/pgbackrest-repo
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_LONG_RANDOM_BACKUP_CIPHER_PASSPHRASE
repo1-retention-full=2
repo1-retention-diff=7
repo1-bundle=y
repo1-block=y

archive-async=y
spool-path=/var/lib/pgbackrest/spool
log-level-console=info
log-level-file=info
log-path=/var/lib/pgbackrest/log
process-max=2
start-fast=y

[perfume_aura]
pg1-path=/var/lib/postgresql/18/docker
pg1-port=5432
# Socket peer login; pg_ident.conf maps the postgres OS user to this role only.
pg1-user=perfume_aura_owner
