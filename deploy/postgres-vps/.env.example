# Copy this file to the root-owned compose environment file described in RUNBOOK.md.
# Values here are deliberately non-secret placeholders. Secret values are file paths only.

POSTGRES_DATABASE=perfume_aura
POSTGRES_OWNER_ROLE=perfume_aura_owner
POSTGRES_MEMORY_LIMIT=3g
POSTGRES_CPU_LIMIT=2.0
# Raw PostgreSQL is available only on VPS loopback for root-controlled owner
# bootstrap and SSH tunnels. Do not bind this to a public interface.
POSTGRES_OWNER_LOOPBACK_PORT=55432

# Existing private network created by deploy/ops-vps/compose.yaml. Do not replace it.
OPS_DOCKER_NETWORK=perfume-aura-ops-internal

# The external pooler is the only public database listener. Keep its default port.
PGBOUNCER_BIND_ADDRESS=0.0.0.0
PGBOUNCER_EXTERNAL_PORT=6432
PGBOUNCER_MEMORY_LIMIT=256m
PGBOUNCER_CPU_LIMIT=0.50

# pgAdmin is intentionally loopback-only. Reach it only through an SSH tunnel.
PGADMIN_LOOPBACK_PORT=5050
PGADMIN_DEFAULT_EMAIL=database-admin@example.invalid

# Each real file is root-owned and lives outside the repository.
POSTGRES_SUPERUSER_PASSWORD_FILE=/etc/perfume-aura-postgres/secrets/postgres-superuser-password
# The bootstrap reads this same owner secret into PGPASSWORD for its direct,
# loopback-only migration connection. Never put this password in DATABASE_URL_DIRECT.
POSTGRES_OWNER_PASSWORD_FILE=/etc/perfume-aura-postgres/secrets/postgres-superuser-password
# Each pooler receives only the verifier for its own runtime role. Do not use
# one shared userlist, or the public listener could authenticate ops users.
PGBOUNCER_OPS_USERLIST_FILE=/etc/perfume-aura-postgres/secrets/pgbouncer-ops-userlist.txt
PGBOUNCER_STOREFRONT_USERLIST_FILE=/etc/perfume-aura-postgres/secrets/pgbouncer-storefront-userlist.txt
PGBOUNCER_TLS_CA_FILE=/etc/perfume-aura-postgres/secrets/mtls-client-ca.crt
PGBOUNCER_TLS_SERVER_CERT_FILE=/etc/perfume-aura-postgres/secrets/mtls-server.crt
PGBOUNCER_TLS_SERVER_KEY_FILE=/etc/perfume-aura-postgres/secrets/mtls-server.key
PGBACKREST_CONFIG_FILE=/etc/perfume-aura-postgres/secrets/pgbackrest.conf
PGADMIN_PASSWORD_FILE=/etc/perfume-aura-postgres/secrets/pgadmin-password

# Used only by bootstrap/bootstrap-runtime-roles.sh, never by Docker Compose.
# All four PostgreSQL role-secret files must contain different values. In
# particular, the normal storefront and payment-finalizer values may never
# match: both roles appear in the public pooler userlist.
OPS_RUNTIME_PASSWORD_FILE=/etc/perfume-aura-postgres/secrets/ops-runtime-password
STOREFRONT_RUNTIME_PASSWORD_FILE=/etc/perfume-aura-postgres/secrets/storefront-runtime-password
STOREFRONT_PAYMENT_FINALIZER_PASSWORD_FILE=/etc/perfume-aura-postgres/secrets/storefront-payment-finalizer-password
