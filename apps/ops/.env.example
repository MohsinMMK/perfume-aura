# Runtime Postgres (pooled for app runtime). For the self-hosted target, use
# the private `postgres-pooler:6432` Docker endpoint with no ssl query params.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Self-hosted ops connects only to the private `postgres-pooler:6432` Docker
# endpoint. Keep every DATABASE_TLS_* value unset: that pooler deliberately
# disables client TLS and is reachable only on the existing private network.
# The public storefront mTLS certificate variables belong only to the
# storefront runtime environment, never to operations.

# Direct connection for drizzle-kit migrations
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Business dates, document-number years, and finance period boundaries
BUSINESS_TIMEZONE=Asia/Karachi

# Better Auth (openssl rand -base64 32) — min 32 characters, high entropy
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# App origin — local dev or https://app.perfumeaura.com in production
BETTER_AUTH_URL=http://localhost:3000

# Hostinger Email SMTP for owner password recovery
# Primary approved transport: SSL/TLS from connection start on port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=owner@perfumeaura.com
SMTP_PASSWORD=set-in-the-runtime-environment-only
SMTP_FROM=Perfume Aura Ops <owner@perfumeaura.com>
# Fallback only after provider verification:
# SMTP_PORT=587
# SMTP_SECURE=false

# Seed the single owner (disableSignUp: true — no public registration)
# Run: pnpm --filter @perfume-aura/ops seed:owner
# Password must be 12–256 characters (same as sign-in/reset/change-password)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-to-a-strong-password

# Break-glass only: SMTP reset is the normal recovery path.
# Run: pnpm --filter @perfume-aura/ops recover:owner
# CONFIRM_OWNER_RECOVERY=REVOKE_ALL_OWNER_SESSIONS

# Operations security release gates. Both default closed: enable only after the
# reviewed migration, runtime-grant reapply, SMTP delivery, owner TOTP, and a
# one-time recovery-code test have passed in production.
OPS_TWO_FACTOR_REQUIRED=false
OPS_STAFF_INVITES_ENABLED=false

# Separate break-glass recovery for a lost owner authenticator. This revokes
# every owner session and removes the enrolled TOTP/recovery codes.
# Run: CONFIRM_OWNER_TWO_FACTOR_RESET=RESET_OWNER_TWO_FACTOR_AND_REVOKE_SESSIONS \
#   pnpm --filter @perfume-aura/ops reset:owner-two-factor

# Optional multi-instance Server Actions crypto (production)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Cashfree owner refund operations. Keep server-side only and match the
# storefront merchant account; never expose these values to the browser.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Observability: Sentry project "perfume-aura-ops" plus the shared free-tier
# PostHog project "Perfume Aura Web" (events carry application=operations).
# Empty DSN/token values keep all telemetry disabled. SENTRY_AUTH_TOKEN is a
# CI/build secret only and must never be exposed as NEXT_PUBLIC_*.
NEXT_PUBLIC_OPS_POSTHOG_TOKEN=
NEXT_PUBLIC_OPS_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_OPS_SENTRY_DSN=
OPS_SENTRY_DSN=
NEXT_PUBLIC_OPS_SENTRY_TRACES_SAMPLE_RATE=0.1
OPS_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
OPS_SENTRY_PROJECT=perfume-aura-ops
SENTRY_AUTH_TOKEN=
