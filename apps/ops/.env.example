# Neon Postgres (pooled for app runtime)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection for drizzle-kit migrations
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Business dates, document-number years, and finance period boundaries
BUSINESS_TIMEZONE=Asia/Karachi

# Better Auth (openssl rand -base64 32) — min 32 characters, high entropy
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# App origin — local dev or https://app.perfumeaura.com in production
BETTER_AUTH_URL=http://localhost:3000

# Hostinger Email SMTP for owner password recovery
# Primary approved transport: SSL/TLS from connection start on port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=owner@perfumeaura.com
SMTP_PASSWORD=set-in-the-runtime-environment-only
SMTP_FROM=Perfume Aura Ops <owner@perfumeaura.com>
# Fallback only after provider verification:
# SMTP_PORT=587
# SMTP_SECURE=false

# Seed the single owner (disableSignUp: true — no public registration)
# Run: pnpm --filter @perfume-aura/ops seed:owner
# Password must be 12–256 characters (same as sign-in/reset/change-password)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-to-a-strong-password

# Break-glass only: SMTP reset is the normal recovery path.
# Run: pnpm --filter @perfume-aura/ops recover:owner
# CONFIRM_OWNER_RECOVERY=REVOKE_ALL_OWNER_SESSIONS

# Optional multi-instance Server Actions crypto (production)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
