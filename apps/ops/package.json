{
  "name": "@perfume-aura/ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.6.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "recover:owner": "tsx scripts/recover-owner.ts",
    "reset:owner-two-factor": "tsx scripts/reset-owner-two-factor.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "tsx --test \"lib/**/!(*.integration).test.ts\"",
    "test:integration": "tsx --test \"lib/**/*.integration.test.ts\""
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@perfume-aura/db": "workspace:*",
    "@perfume-aura/ui": "workspace:*",
    "@perfume-aura/validators": "workspace:*",
    "@sentry/nextjs": "10.73.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "posthog-js": "1.424.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  }
}
