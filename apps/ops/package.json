    "@hugeicons/react": "^1.1.10",
    "@perfume-aura/db": "workspace:*",
    "@perfume-aura/validators": "workspace:*",
    "@sentry/nextjs": "11.9.0",
    "@stylexjs/stylex": "0.19.1",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "posthog-js": "1.440.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
