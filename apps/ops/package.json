    "test:integration": "tsx --test \"lib/**/*.integration.test.ts\""
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@perfume-aura/db": "workspace:*",
    "@perfume-aura/ui": "workspace:*",
    "@perfume-aura/validators": "workspace:*",
    "@sentry/nextjs": "10.69.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "posthog-js": "1.407.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
