# Runtime database (restricted pooled role)
DATABASE_URL=

# Public/storefront origins
STOREFRONT_URL=https://perfumeaura.com
CUSTOMER_AUTH_URL=https://perfumeaura.com
CUSTOMER_AUTH_SECRET=
STOREFRONT_CUSTOMER_AUTH_ENABLED=false

# Optional customer OAuth provider (release-gated)
CUSTOMER_GOOGLE_CLIENT_ID=
CUSTOMER_GOOGLE_CLIENT_SECRET=

# Customer transactional email (Hostinger SMTP only)
CUSTOMER_SMTP_HOST=smtp.hostinger.com
CUSTOMER_SMTP_PORT=465
CUSTOMER_SMTP_SECURE=true
CUSTOMER_SMTP_USER=
CUSTOMER_SMTP_PASSWORD=
CUSTOMER_SMTP_FROM=

# Commerce providers and release gates
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_PAYMENT_TTL_MINUTES=20
STOREFRONT_PREVIEW_CATALOG=false
STOREFRONT_PUBLIC_RELEASE=false
STOREFRONT_CHECKOUT_RELEASE_APPROVED=false
STOREFRONT_MAINTENANCE_SECRET=
STOREFRONT_INQUIRIES_ENABLED=false
STOREFRONT_INQUIRY_CONSENT_VERSION=

# Observability: Sentry project "perfume-aura-storefront" plus the shared
# free-tier PostHog project "Perfume Aura Web" (application=storefront).
# Empty DSN/token values keep all telemetry disabled. SENTRY_AUTH_TOKEN is a
# CI/build secret only and must never be exposed as NEXT_PUBLIC_*.
NEXT_PUBLIC_STOREFRONT_POSTHOG_TOKEN=
NEXT_PUBLIC_STOREFRONT_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_STOREFRONT_SENTRY_DSN=
STOREFRONT_SENTRY_DSN=
NEXT_PUBLIC_STOREFRONT_SENTRY_TRACES_SAMPLE_RATE=0.1
STOREFRONT_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
STOREFRONT_SENTRY_PROJECT=perfume-aura-storefront
SENTRY_AUTH_TOKEN=
