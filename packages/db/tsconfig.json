{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "drizzle.config.ts",
    "drizzle.phase02-test.config.ts"
  ],
  "exclude": ["node_modules", "drizzle", "src/**/*.test.ts"]
}
