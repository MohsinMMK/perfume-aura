{
  "name": "@perfume-aura/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:through-auth-expansion": "tsx src/migrate-through-auth-expansion.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "tsx --test \"src/**/!(*.integration).test.ts\"",
    "test:integration": "tsx --test \"src/**/*.integration.test.ts\"",
    "test:phase04-migrations": "tsx --test src/phase04-migrations.integration.test.ts",
    "test:phase03": "tsx --test src/business-time.test.ts src/transactions.test.ts src/inventory.integration.test.ts src/phase03-workflows.integration.test.ts",
    "test:phase02-design": "tsx --test src/phase02-contract-design.test.ts",
    "test:phase02-safety": "tsx --test src/test-database-guard.test.ts",
    "test:phase02-migrations": "tsx --test src/phase02-migrations.integration.test.ts",
    "migrate:phase02-test": "drizzle-kit migrate --config=drizzle.phase02-test.config.ts",
    "preflight:phase02": "tsx src/phase02-preflight.ts",
    "reconcile:phase02": "tsx src/phase02-reconcile.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
